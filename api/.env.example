# ==================================================================
# APLICACION
# ==================================================================

# Clave secreta para firmar tokens JWT.
# Generar con: python scripts/generate_secret.py
SECRET_KEY=

# CORS: origenes permitidos (separados por comas).
# - En DESARROLLO: dejar vacio para permitir localhost:3000, 5173, etc.
# - En PRODUCCION: definir explicitamente. NUNCA usar '*'.
CORS_ALLOWED_ORIGINS=

# Expiracion del token JWT en minutos (un turno de servicio = 8 h)
JWT_EXP_MINUTES=480

# Dias de anticipacion por defecto para alertar vencimientos
DIAS_ALERTA_DEFECTO=3

# ==================================================================
# BASE DE DATOS (MySQL)
# ==================================================================
# Si DB_USER queda VACIO la API usa un archivo SQLite local
# (instance/sinu.db) para poder ejecutar la demo sin MySQL.
# ==================================================================

DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sinu_db
DB_CHARSET=utf8mb4

# Flask CLI (flask db ...)
FLASK_APP=app:crear_app
